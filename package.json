{
  "name": "@startdownnotez404/playground3-stage-sdk",
  "version": "0.1.3",
  "description": "Playground3 Stage SDK for author apps (mount, turn runner, whiteboard/ontology toolkits, FlowMap, host-ui widgets).",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./host-ui": {
      "types": "./dist/host-ui.d.ts",
      "import": "./dist/host-ui.js",
      "default": "./dist/host-ui.js"
    },
    "./xyflow-style.css": "./dist/xyflow-style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css",
    "./dist/index.js",
    "./dist/host-ui.js"
  ],
  "scripts": {
    "build": "node ./scripts/build.mjs"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.9",
    "@mui/material": "^7.3.9",
    "@types/node": "^22.13.10",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@xyflow/react": "^12.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.8.2",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "@mui/material": "^7",
    "@mui/icons-material": "^7",
    "@emotion/react": "^11",
    "@emotion/styled": "^11",
    "@xyflow/react": "^12"
  },
  "peerDependenciesMeta": {
    "@mui/icons-material": {
      "optional": true
    },
    "@xyflow/react": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/startdownnotez404/playground3-stage-sdk.git"
  },
  "license": "MIT",
  "author": "startdownnotez404"
}
